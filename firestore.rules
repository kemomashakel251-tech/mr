rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // مستند التحقق من صلاحية الأدمن - يقرأ بياناته فقط، الكتابة يدويًا من الكونسول
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // محتوى الصفحة الرئيسية - عرض للجميع، تعديل للأدمن فقط
    match /siteContent/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // الكورسات ودروسها
    match /courses/{courseId} {
      allow read: if true;
      allow write: if isAdmin();

      match /lessons/{lessonId} {
        // الدروس تُقرأ فقط من الطالب المسجل في الكورس أو الأدمن
        allow read: if isAdmin() || (
          request.auth != null &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.enrolledCourses.hasAny([courseId])
        );
        allow write: if isAdmin();
      }
    }

    // المدرسين
    match /teachers/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // آراء الطلاب
    match /testimonials/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // بيانات المستخدمين
    match /users/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow create: if request.auth != null && request.auth.uid == uid;
      allow update: if isAdmin() || (request.auth != null && request.auth.uid == uid &&
        request.resource.data.enrolledCourses == resource.data.enrolledCourses); // الطالب مايقدرش يعدل كورساته بنفسه
      allow delete: if isAdmin();
    }

    // طلبات الاشتراك
    match /enrollmentRequests/{id} {
      allow create: if request.auth != null && request.resource.data.studentId == request.auth.uid;
      allow read: if isAdmin() || (request.auth != null && resource.data.studentId == request.auth.uid);
      allow update, delete: if isAdmin();
    }
  }
}
